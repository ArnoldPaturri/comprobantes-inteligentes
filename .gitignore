# Entorno local y secretos
.env
.env.*
!.env.example
.venv/
venv/
credenciales/
credentials/
.streamlit/secrets.toml
*.pem
*.key
*.p12

# Archivos personales, comprobantes y resultados
entrada/*
!entrada/ejemplos/
entrada/ejemplos/*
!entrada/ejemplos/.gitkeep
salida/*
!salida/.gitkeep

# Directorios anteriores: conservar ignorados durante la migración
input/
output/

# Python, distribución, herramientas y cobertura
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Bases de datos locales
*.db
*.sqlite
*.sqlite3

# Adjuntos privados de conciliación (junto al libro de Excel)
adjuntos_financieros/
